# Required for SEC Company Facts requests. Replace with your app name and a monitored contact email.
SEC_USER_AGENT=PratikshaFinanceDashboard/1.0 (your-email@example.com)
PORT=3002
# IndianAPI key from your IndianAPI dashboard. Keep the real key in .env.
INDIANAPI_API_KEY=your-indianapi-api-key
# Free EODHD account token enables global name/symbol search (20 API calls/day).
EODHD_API_TOKEN=your-eodhd-api-token
